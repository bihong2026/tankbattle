[Unit]
Description=Tank Battle backend service (tankbattle)
# 换成你自己的访问地址，或者删掉这一行。
Documentation=http://127.0.0.1:9010/
# MySQL 的服务名按发行版来：Ubuntu / Debian 是 mysql.service，
# RHEL / CentOS / Alma 才是 mysqld.service。写错了服务起不来。
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
# 改成跑这个服务的系统用户（下面所有路径都要跟着它）。
User=tank
Group=tank
WorkingDirectory=/opt/tankbattle/server
# 数据库口令之类的参数放这个文件里，别写进 unit（unit 通常人人可读）。
# 文件长这样（记得 chown root:root + chmod 600）：
#   TANK_DB_HOST=127.0.0.1
#   TANK_DB_USER=tank
#   TANK_DB_PASSWORD=...
#   TANK_DB_NAME=tankbattle
# 前面的 - 表示文件不存在也不报错（这时用 db.py 里的默认值）。
EnvironmentFile=-/etc/tankbattle.env
Environment=PYTHONUNBUFFERED=1
# 默认只绑回环：对外交给 nginx 的 /tanks/ 反代出去（见 README 的「放到公网」一节）。
# 确实想让服务直接对外监听，再改成 0.0.0.0:9010。
ExecStart=/opt/tankbattle/venv/bin/gunicorn --workers 4 --bind 127.0.0.1:9010 --access-logfile - --error-logfile - --timeout 30 app:app
Restart=always
RestartSec=3
KillSignal=SIGTERM
NoNewPrivileges=true
# 机器上还有别的服务时建议留着：它失控了也挤不掉邻居。
MemoryMax=512M

[Install]
WantedBy=multi-user.target
